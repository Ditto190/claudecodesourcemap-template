{
  "name": "@anthropic-ai/claude-code",
  "version": "0.2.8",
  "description": "Claude Code - Agentic coding tool for your terminal",
  "type": "module",
  "bin": {
    "claude": "./cli.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-node-version.mjs",
